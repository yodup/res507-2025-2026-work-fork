<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>QuoteBoard</title>
  <style>
    :root {
      --bg: #111;
      --text: #eee;
      --muted: #9a9a9a;
      --surface: #1b1b1b;
      --border: #333;
      --pink: #ff4d9d;
      --pink-soft: rgba(255, 77, 157, 0.25);
      --radius: 12px;
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: system-ui, sans-serif;
      max-width: 700px;
      margin: 2rem auto;
      padding: 0 1rem;
      background: var(--bg);
      color: var(--text);
    }

    h1 {
      margin-bottom: 1.5rem;
    }

    /* ---------- Formulaire ---------- */
    form {
      display: grid;
      gap: 0.75rem;
      margin-bottom: 2.5rem;
    }

    input,
    textarea,
    button {
      font: inherit;
      color: var(--text);
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.75rem 1rem;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    textarea {
      min-height: 110px;
      resize: vertical;
    }

    input::placeholder,
    textarea::placeholder {
      color: var(--muted);
    }

    input:focus,
    textarea:focus {
      outline: none;
      border-color: var(--pink);
      box-shadow: 0 0 0 3px var(--pink-soft);
    }

    button {
      cursor: pointer;
      background: var(--pink);
      border-color: var(--pink);
      color: #111;
      font-weight: 600;
    }

    button:hover {
      filter: brightness(1.1);
    }

    button:focus-visible {
      outline: none;
      box-shadow: 0 0 0 3px var(--pink-soft);
    }

    /* ---------- Citations ---------- */
    .quote {
      position: relative;
      margin: 0 0 1.25rem;
      padding: 1.25rem 1.5rem 1.25rem 2.75rem;
      background: var(--surface);
      border-left: 4px solid var(--pink);
      border-radius: 0 var(--radius) var(--radius) 0;
    }

    .quote::before {
      content: "\201C";
      position: absolute;
      left: 0.75rem;
      top: 0.25rem;
      font-family: Georgia, serif;
      font-size: 3rem;
      line-height: 1;
      color: var(--pink);
    }

    .quote-text {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.15rem;
      font-style: italic;
      line-height: 1.5;
    }

    .quote-author {
      margin-top: 0.75rem;
      text-align: right;
      font-size: 0.9rem;
      color: var(--muted);
    }
  </style>
</head>

<body>
  <h1>QuoteBoard</h1>

  <form method="post" action="/quotes">
    <input name="author" placeholder="Author (optional)" />
    <textarea name="text" placeholder="Write a quote..." required></textarea>
    <button type="submit">Add quote</button>
  </form>

  {{#if quotes.length}}
  {{#each quotes}}
  <blockquote class="quote">
    <p class="quote-text">{{this.text}}</p>
    {{#if this.author}}<footer class="quote-author">— {{this.author}}</footer>{{/if}}
  </blockquote>
  {{/each}}
  {{else}}
  <p>No quotes yet. Add the first one.</p>
  {{/if}}
</body>

</html>